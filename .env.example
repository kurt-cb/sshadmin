# SSH Certificate Admin Configuration

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Secret key for session management (change this in production!)
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///sshadmin.db

# SSH CA Keys (configure paths on your system)
SSH_CA_KEY=/etc/ssh/ca_key
SSH_CA_PUBKEY=/etc/ssh/ca_key.pub

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
